# load-tests/.env.example — copy to load-tests/.env and fill in values for
# your target Supabase project. Prefer a disposable/staging project. If you
# must target a production project (e.g. before real users exist — see
# CONFIRMED_PROJECT_REFS below), use strict test-data isolation: a dedicated
# game whose code starts with "LOADTEST", TEST_-prefixed synthetic player
# names, and scoped-only cleanup. Never run against a project with real
# users without explicit, informed authorization from whoever owns it.
#
# These are read by k6 via -e NAME=value (k6 does not auto-load .env files),
# so load this file into your shell session first. See README.md.

# ---------------------------------------------------------------------------
# Supabase connection
# ---------------------------------------------------------------------------
# Same value as VITE_SUPABASE_URL in the app's own .env.local.
# e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# The anon/public key for that project. Never use a service_role key here —
# these scripts intentionally exercise the same anon-key RLS/RPC path real
# players use. (The two Node bootstrap/cleanup scripts under scripts/ do use
# a service_role key, passed separately as SUPABASE_SERVICE_ROLE_KEY — never
# put that key here, and never pass it to any k6 script.)
SUPABASE_ANON_KEY=

# Explicit allowlist of project refs (the subdomain segment of SUPABASE_URL)
# this suite is authorized to run against. This is a deliberate allowlist,
# not a "looks like prod" hostname guess — add a ref here only after
# explicitly confirming with the project's owner that load testing against
# it is authorized, and understanding whether it's staging or production.
CONFIRMED_PROJECT_REFS=

# ---------------------------------------------------------------------------
# Test game identity (produced by `npm run bootstrap`, see README.md)
# ---------------------------------------------------------------------------
# The games.code of the dedicated load-test game. MUST start with
# "LOADTEST" — cleanup-game.mjs refuses to delete anything otherwise.
GAME_CODE=LOADTEST

# The games.id (uuid) of that same game. Needed for host-only RPCs
# (call_next_word) which take a game id, not a code.
GAME_ID=

# The games.host_secret (uuid) of that same game. Treat this like a
# credential: it grants host control (advancing words, pausing, resetting)
# over the test game. Never reuse a production game's host_secret here.
HOST_SECRET=

# ---------------------------------------------------------------------------
# Load profile knobs (optional — scripts fall back to sensible defaults)
# ---------------------------------------------------------------------------
# Base virtual-user count for scenarios that scale a single stage from this,
# e.g. soak test. Individual scenario files hardcode their own ramp stages
# per the request (10/25/50/100) but read this for quick overrides where noted.
MAX_VUS=100

# Soak test duration in minutes (default 25, i.e. inside the requested 20-30).
SOAK_DURATION_MIN=25
